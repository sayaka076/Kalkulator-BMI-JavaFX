<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="540.0" prefWidth="420.0" spacing="20.0"
      style="-fx-background-color: linear-gradient(to bottom right, #090909, #1f0505, #450a0a);"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.kalkulatorbmi.PrimaryController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Card Container Utama -->
    <VBox alignment="CENTER" spacing="18.0"
          style="-fx-background-color: #121212; -fx-background-radius: 16; -fx-border-color: #7f1d1d; -fx-border-radius: 16; -fx-border-width: 1.5;">
        <padding>
            <Insets bottom="28.0" left="25.0" right="25.0" top="28.0" />
        </padding>
        <effect>
            <DropShadow blurType="GAUSSIAN" height="30.0" radius="14.5" width="30.0">
                <color>
                    <Color red="0.0" green="0.0" blue="0.0" opacity="0.75" />
                </color>
            </DropShadow>
        </effect>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="4.0">
            <Label text="BMI CALCULATOR" textFill="#ef4444">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>
            <Label text="Indeks Massa Tubuh Ideal" textFill="#9ca3af">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>

        <!-- Input Tinggi Badan -->
        <VBox spacing="6.0">
            <Label text="Tinggi Badan (cm)" textFill="#e5e7eb">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Label>
            <TextField fx:id="txtTinggi" promptText="Contoh: 170"
                       style="-fx-background-color: #1c1c1c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 8; -fx-border-color: #450a0a; -fx-border-radius: 8; -fx-padding: 10;" />
        </VBox>

        <!-- Input Berat Badan -->
        <VBox spacing="6.0">
            <Label text="Berat Badan (kg)" textFill="#e5e7eb">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Label>
            <TextField fx:id="txtBerat" promptText="Contoh: 65"
                       style="-fx-background-color: #1c1c1c; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 8; -fx-border-color: #450a0a; -fx-border-radius: 8; -fx-padding: 10;" />
        </VBox>

        <!-- Tombol Aksi -->
        <HBox alignment="CENTER" spacing="12.0">
            <Button fx:id="btnHitung" onAction="#hitungBmi" prefHeight="40.0" prefWidth="190.0"
                    style="-fx-background-color: linear-gradient(to right, #dc2626, #991b1b); -fx-text-fill: #ffffff; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="HITUNG BMI">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Button>
            <Button fx:id="btnReset" onAction="#resetForm" prefHeight="40.0" prefWidth="95.0"
                    style="-fx-background-color: #262626; -fx-text-fill: #d1d5db; -fx-background-radius: 8; -fx-border-color: #404040; -fx-border-radius: 8; -fx-cursor: hand;"
                    text="RESET">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Button>
        </HBox>

        <!-- Panel Hasil Sementara -->
        <VBox alignment="CENTER" spacing="6.0"
              style="-fx-background-color: linear-gradient(to bottom, #1a0505, #0a0a0a); -fx-background-radius: 12; -fx-border-color: #450a0a; -fx-border-radius: 12; -fx-padding: 16;">
            <Label text="SKOR BMI ANDA" textFill="#9ca3af">
                <font>
                    <Font name="System Bold" size="11.0" />
                </font>
            </Label>
            <Label fx:id="lblSkorBmi" text="--.-" textFill="#ffffff">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
            <Label fx:id="lblKategori" text="Masukkan tinggi &amp; berat badan" textFill="#ef4444">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
        </VBox>
    </VBox>
</VBox>